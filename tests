def test_list_devices(client, db_session):
    user = create_test_user(db_session)
    create_test_device(db_session, user, device_id="device-1")
    create_test_device(db_session, user, device_id="device-2")
    # Simulate login and JWT (mocking for test)
    from src.auth import create_access_token
    token = create_access_token({"user_id": str(user.id), "username": user.username, "is_admin": user.is_admin})
    headers = {"Authorization": f"Bearer {token}"}
    response = client.get("/devices", headers=headers)
    assert response.status_code == 200
    assert isinstance(response.json(), list)
    assert len(response.json()) == 2


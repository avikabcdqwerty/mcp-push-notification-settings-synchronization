# tests/test_settings_sync.py
import uuid
from src.models import User, Device, PushNotificationSettings
from src.schemas import UserSettingsUpdateRequest, DeviceSettingsUpdateRequest

def create_test_user(db, username="testuser", email="test@example.com", is_admin=False):
    user = User(
        id=uuid.uuid4(),
        username=username,
        email=email,
        password_hash="hashedpassword",
        is_active=True,
        is_admin=is_admin,
    )
    db.add(user)
    db.commit()
    db.refresh(user)
    return user

def create_test_device(db, user, device_id="device-1", device_type="ios", is_push_enabled=True):
    device = Device(
        device_id=device_id,
        user_id=user.id,
        device_type=device_type,
        device_name="Test Device",
        push_token="token123",
        is_push_enabled=is_push_enabled,
    )
    db.add(device)
    db.commit()
    db.refresh(device)
    return device

def test_user_settings_sync(db_session):
    user = create_test_user(db_session)
    # Update user settings
    from src.crud import update_user_settings, get_user_settings
    payload = UserSettingsUpdateRequest(settings={"categories": ["alerts"]}, is_enabled=True)
    updated = update_user_settings(db_session, user.id, payload)
    assert updated.settings["categories"] == ["alerts"]
    # Sync: settings should be reflected for user
    fetched = get_user_settings(db_session, user.id)
    assert fetched.settings["categories"] == ["alerts"]

def test_device_settings_enable_disable(db_session):
    user = create_test_user(db_session)
    device = create_test_device(db_session, user)
    from src.crud import update_device_settings, get_device_settings
    payload = DeviceSettingsUpdateRequest(is_push_enabled=False)
    updated = update_device_settings(db_session, user.id, device.device_id, payload)
    assert updated.is_push_enabled is False
    # Re-enable
    payload = DeviceSettingsUpdateRequest(is_push_enabled=True)
    updated = update_device_settings(db_session, user.id, device.device_id, payload)
    assert updated.is_push_enabled is True

def test_prevent_duplicate_notifications(db_session):
    user = create_test_user(db_session)
    device = create_test_device(db_session, user)
    from src.notification import deduplicate_notification
    event_payload = {"event_id": "evt-123", "message": "Test"}
    # First send should be allowed
    assert deduplicate_notification(db_session, user.id, event_payload) is True
    # Second send within window should be blocked
    assert deduplicate_notification(db_session, user.id, event_payload) is False

def test_audit_logging(db_session):
    user = create_test_user(db_session)
    from src.audit import log_audit_event, get_audit_logs_for_user
    log_audit_event(db_session, user.id, "TEST_EVENT", "details here", ip_address="127.0.0.1", session_id="sess-1")
    logs = get_audit_logs_for_user(db_session, user.id)
    assert len(logs) == 1
    assert logs[0].event_type == "TEST_EVENT"
    assert logs[0].ip_address == "127.0.0.1"

